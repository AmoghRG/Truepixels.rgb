# TruePixels.rgb - Environment Template
APP_NAME=TruePixels.rgb
ENVIRONMENT=development
DEBUG=True

# Database Configuration (defaults to SQLite if not PostgreSQL)
DATABASE_URL=sqlite:///./truepixels.db

# Security & JWT Session
JWT_SECRET_KEY=dev_secret_key_truepixels_rgb_84739274927394829374829374928374
JWT_ALGORITHM=HS256
SESSION_EXPIRE_HOURS=8

# Storage Paths & Limits
STORAGE_DIR=./storage
MAX_UPLOAD_SIZE_MB=10
MIN_IMAGE_DIMENSION=64
MAX_IMAGE_PIXELS=25000000

# Email Service Configuration (2FA / OTP)
EMAIL_BACKEND=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_16_char_google_app_password
SMTP_FROM=your_email@gmail.com
SMTP_USE_SSL=False
OTP_EXPIRE_MINUTES=5
REQUIRE_2FA=True
